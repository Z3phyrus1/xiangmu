session = as.numeric(str_sub(as.character(id_sess), -1, -1)),
# 复杂的 task 逻辑更新
# 逻辑：如果 (id+session) 是奇数，decision=1是motion；如果是偶数，decision=2是motion
task_update = case_when(
!is.na(id) & !is.na(session) & ((id + session) %% 2 != 0) & decision == 1 ~ "motion",
!is.na(id) & !is.na(session) & ((id + session) %% 2 != 0) & decision != 1 ~ "orientation",
!is.na(id) & !is.na(session) & ((id + session) %% 2 == 0) & decision == 2 ~ "motion",
!is.na(id) & !is.na(session) & ((id + session) %% 2 == 0) & decision != 2 ~ "orientation",
TRUE ~ task # 保持原值
)
) %>%
# 替换原来的 task 列
mutate(task = task_update) %>%
select(-task_update) %>% # 移除临时列
# 调整列顺序：把 seq 放在 id 后面
relocate(seq, .after = id)
# 执行分析
analyze_data_func(final_df)
# 理论行数计算
total_subjects <- n_distinct(final_df$id, na.rm = TRUE)
total_sessions <- n_distinct(final_df$session, na.rm = TRUE)
total_blocks <- if("block" %in% names(final_df)) n_distinct(final_df$block, na.rm = TRUE) else 0
if (total_blocks > 0) {
theoretical_rows <- total_subjects * total_sessions * total_blocks * 100
message(paste("理论总行数:", theoretical_rows))
message(paste("实际总行数:", nrow(final_df)))
message(paste("差异:", nrow(final_df) - theoretical_rows))
}
# 保存 CSV
output_path <- path(folder_path, "data_for_behavior.csv")
write_csv(final_df, output_path, na = "NaN")
message(paste("\n数据已保存到:", output_path))
message(paste("总数据行数:", nrow(final_df)))
} else {
message("未找到任何 Excel 文件")
}
} else {
message(paste("错误：目录不存在 -", folder_path))
}
# Script 3: analyze_data.R
library(tidyverse)
library(readxl)
library(writexl)
library(fs)
library(stringr)
# 提取文件名中的序列号函数
get_seq_from_filename <- function(filename) {
name_without_ext <- path_ext_remove(filename)
nums <- str_extract_all(name_without_ext, "\\d+")[[1]]
if (length(nums) > 0) {
last_num <- tail(nums, 1)
if (nchar(last_num) >= 2) {
return(str_sub(last_num, -2))
} else {
return(str_pad(last_num, 2, pad = "0"))
}
} else {
return("00")
}
}
analyze_data_func <- function(df) {
message("\n数据分析:")
message(strrep("=", 50))
message(paste("总行数:", nrow(df)))
if ("seq" %in% names(df)) {
message("\n各seq数据行数:")
print(df %>% count(seq) %>% arrange(seq))
}
if ("id" %in% names(df)) {
message("\n各id数据行数:")
print(df %>% count(id) %>% arrange(id))
}
if ("task" %in% names(df)) {
message("\n各task数据行数:")
task_stats <- df %>%
count(task) %>%
mutate(percentage = n / sum(n) * 100)
print(task_stats)
}
message("\n缺失值检查:")
na_counts <- colSums(is.na(df))
na_counts <- na_counts[na_counts > 0]
if (length(na_counts) > 0) {
print(na_counts)
} else {
message("  无缺失值")
}
dupes <- sum(duplicated(df))
message(paste("重复行数:", dupes))
message(strrep("=", 50))
}
# --- 主程序执行 ---
folder_path <- "D:/xiangmu/data/raw_behavior"
all_data_list <- list()
if (dir_exists(folder_path)) {
message(paste("扫描目录:", folder_path))
subfolders <- dir_ls(folder_path, type = "directory")
for (subfolder in subfolders) {
# 取 Excel 文件
xlsx_files <- dir_ls(subfolder, glob = "*.xlsx")
for (f in xlsx_files) {
tryCatch({
# 读取数据 (默认让R猜测类型)
df <- read_excel(f, sheet = 1, .name_repair = "unique_quiet")
seq_val <- get_seq_from_filename(path_file(f))
df <- df %>% mutate(seq = seq_val)
# 统一关键列为字符，防止后续合并报错
if("id_sess" %in% names(df)) df$id_sess <- as.character(df$id_sess)
all_data_list[[length(all_data_list) + 1]] <- df
message(paste("  已读取:", path_file(f), "(seq:", seq_val, ", 行数:", nrow(df), ")"))
}, error = function(e) {
message(paste("  读取错误:", path_file(f), e$message))
})
}
}
if (length(all_data_list) > 0) {
# 合并
merge_df <- bind_rows(all_data_list)
message(paste("合并完成，总数据行数:", nrow(merge_df)))
# --- 数据处理逻辑 (核心转换部分) ---
final_df <- merge_df %>%
mutate(
# 1. 关键：将参与计算的列显式转为数值型
# 因为 Script 2 之前为了安全把它们存成了文本
mu = as.numeric(mu),
side = as.numeric(side),
coherence = as.numeric(coherence),
decision = as.numeric(decision),
# 2. 关键：将 task 转为字符型
# 这样 case_when 里的 "motion" (字符) 和 task (原值) 才能兼容
task = as.character(task),
# 3. 提取 id 和 session
id = as.numeric(str_sub(as.character(id_sess), 1, 2)),
session = as.numeric(str_sub(as.character(id_sess), -1, -1)),
# 4. 数学计算
signed_mu = side * mu,
signed_coherence = side * coherence
) %>%
mutate(
# 5. 复杂的 task 逻辑更新
# 这里现在是安全的，因为 task 已经是字符型，decision 已经是数值型
task_update = case_when(
!is.na(id) & !is.na(session) & ((id + session) %% 2 != 0) & decision == 1 ~ "motion",
!is.na(id) & !is.na(session) & ((id + session) %% 2 != 0) & decision != 1 ~ "orientation",
!is.na(id) & !is.na(session) & ((id + session) %% 2 == 0) & decision == 2 ~ "motion",
!is.na(id) & !is.na(session) & ((id + session) %% 2 == 0) & decision != 2 ~ "orientation",
TRUE ~ task # 保持原值 (字符型)
)
) %>%
mutate(task = task_update) %>%
select(-task_update) %>%
relocate(seq, .after = id)
# 执行分析
analyze_data_func(final_df)
# 理论行数计算
total_subjects <- n_distinct(final_df$id, na.rm = TRUE)
total_sessions <- n_distinct(final_df$session, na.rm = TRUE)
total_blocks <- if("block" %in% names(final_df)) n_distinct(final_df$block, na.rm = TRUE) else 0
if (total_blocks > 0) {
theoretical_rows <- total_subjects * total_sessions * total_blocks * 100
message(paste("理论总行数:", theoretical_rows))
message(paste("实际总行数:", nrow(final_df)))
message(paste("差异:", nrow(final_df) - theoretical_rows))
}
# 保存 CSV
output_path <- path(folder_path, "data_for_behavior.csv")
write_csv(final_df, output_path, na = "NaN")
message(paste("\n数据已保存到:", output_path))
message(paste("总数据行数:", nrow(final_df)))
} else {
message("未找到任何 Excel 文件")
}
} else {
message(paste("错误：目录不存在 -", folder_path))
}
#
# make lookup table for the integral of optimal mosign_sdel
#
# clear workspace?
rm(list=ls())
binsize <- 0.0125 #0.00625
st <- seq(-10,10,binsize)
tab_plus = matrix(nrow=length(st),ncol=length(st))
tab_minus = matrix(nrow=length(st),ncol=length(st))
# functions
# erf <- function(x)
# {
# 	# from: numerical recipes in C, 2nd ed
# 	t <- 1/(1+0.5*abs(x))
# 	tau <- t*exp(-x^2 -1.26551223 + 1.00002368*t + 0.37409196*t^2 + 0.09678418*t^3 - 0.18628806*t^4 + 0.27886807*t^5 - 1.13520398*t^6 + 1.48851587*t^7 - 0.82215223*t^8 + 0.17087277*t^9)
# 	return(ifelse(x>=0, 1-tau, tau -1))
# }
# alternative formulation in R
erf <- function(x) 2 * pnorm(x * sqrt(2)) - 1
Fplus <- function(x,s1,s2) erf(x + s2) * exp(-(x-s1)^2)
Fminus <- function(x,s1,s2) erf(x - s2) * exp(-(x-s1)^2)
# fill table (s1 on rows)
for(s1 in 1:length(st))
{
for(s2 in 1:length(st))
{
integrand_plus <- function(x) Fplus(x, st[s1], st[s2])
integrand_minus <- function(x) Fminus(x, st[s1], st[s2])
tab_plus[s1,s2] <- (1/sqrt(pi)) * integrate(integrand_plus, lower= 0, upper= Inf)$value
tab_minus[s1,s2] <- (1/sqrt(pi)) * integrate(integrand_minus, lower= -Inf, upper= 0)$value
}
}
# save the RDS files that are necessary to estimate likelihood of optimal model
saveRDS(tab_plus,file="tabplus.rds",compress=F)
saveRDS(tab_minus,file="tabminus.rds",compress=F)
saveRDS(st,file="tabindex.rds",compress=F)
# lookup function (also perform bilinear interpolation)
# intF <- function(s1,s2,tab,ind)
# {
# ti <- findInterval(c(s1,s2), ind)
# a <- matrix(c(rep(1,4),rep(ind[ti[1]],2),rep(ind[ti[1]+1],2),ind[ti[2]],ind[ti[2]+1],ind[ti[2]],ind[ti[2]+1]),4,4)
# a[,4] <- a[,2]*a[,3]
# b <- c(tab[ti[1],ti[2]], tab[ti[1],ti[2]+1], tab[ti[1]+1,ti[2]], tab[ti[1],ti[2]+1])
# beta <- solve(a,b)
# return(beta[1] + beta[2]*s1 + beta[3]*s2 + beta[4]*s1*s2)
# }
# faster version
# (don't use solve, which is an interface to fortran package LAPACK, routines DGESV and ZGESV)
intF <- function(x,y,tab,ind)
{
ti <- findInterval(c(x,y), ind)
x1 <- ind[ti[1]]; x2 <- ind[ti[1]+1]
y1 <- ind[ti[2]]; y2 <- ind[ti[2]+1]
(1/((x2-x1)*(y2-y1))) * (tab[ti[1],ti[2]]*(x2-x)*(y2-y) + tab[ti[1]+1,ti[2]]*(x-x1)*(y2-y) + tab[ti[1],ti[2]+1]*(x2-x)*(y-y1) + tab[ti[1]+1,ti[2]+1]*(x-x1)*(y-y1))
}
